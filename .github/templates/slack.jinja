{
  "text": "{{ status_icon }} CI Test Run {{ status_label }} — {{ repository }} (#{{ run_number }})",
  "attachments": [
    {
      "color": "{{ status_color }}",
      "fields": [
        {
          "title": "Repository",
          "value": "{{ repository }}",
          "short": true
        },
        {
          "title": "Branch",
          "value": "{{ branch }}",
          "short": true
        },
        {
          "title": "Run #",
          "value": "{{ run_number }}",
          "short": true
        },
        {
          "title": "Commit",
          "value": "{{ commit }}",
          "short": true
        },
        {
          "title": "Test Results",
          "value": "Total: *{{ tests_total }}*  |  ✅ Passed: *{{ tests_passed }}*  |  ❌ Failed: *{{ tests_failed }}*  |  ⏭ Skipped: *{{ tests_skipped }}*",
          "short": false
        }
        {%- if failed_tests_block %}
      ,{
          "title": "❌ Failed Tests",
          "value": {{ ("```" + failed_tests_block + "```") | tojson }},
        "short": false
        }
        {%- endif %}
        {%- if status == "success" %}
      ,{
          "title": "View Full Logs",
          "value": "<{{ run_url }}|Open in GitHub Actions>",
          "short": false
        }
        {%- endif %}
      ]
    }
  ]
}